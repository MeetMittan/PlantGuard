NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info

MONGODB_URI=mongodb://127.0.0.1:27017/plantguard_ai

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

ACCESS_TOKEN_SECRET=your_access_token_secret_min_32_characters_long
REFRESH_TOKEN_SECRET=your_refresh_token_secret_min_32_characters_long

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage/uploads

MAX_IMAGE_UPLOAD_MB=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_MAX_REQUESTS=10

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
